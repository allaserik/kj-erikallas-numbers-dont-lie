# Full Docker Setup with Demo Data
# Use this with: source .env.docker.demo && docker-compose up -d
# Or just: DEMO_MODE=true VITE_DEMO_MODE=true docker-compose up -d

# Postgres in Docker
POSTGRES_DB=ndl
POSTGRES_USER=ndl
POSTGRES_PASSWORD=ndl_password
POSTGRES_PORT=5432

# Backend in Docker
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Demo Mode - Seeds demo user with 30 days of sample data
DEMO_MODE=true

# Frontend in Docker (do NOT set VITE_API_BASE_URL - uses relative paths)
# VITE_API_BASE_URL= (omitted - nginx proxies via relative paths)
VITE_AUTH0_AUDIENCE=https://numbers-dont-lie-api
VITE_DEMO_MODE=true
