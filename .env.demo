# Demo Environment - For LOCAL DEVELOPMENT with Docker database only
# Use this with: source .env.demo && <then run npm/./mvnw locally>

# Postgres in Docker
POSTGRES_DB=ndl
POSTGRES_USER=ndl
POSTGRES_PASSWORD=ndl_password
POSTGRES_PORT=5432

# Backend (runs locally)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/ndl
DATABASE_USER=ndl
DATABASE_PASSWORD=ndl_password

# Demo Mode - Seeds demo user with 30 days of sample data
DEMO_MODE=true

# Frontend (runs locally with dev server)
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH0_AUDIENCE=https://numbers-dont-lie-api
VITE_DEMO_MODE=true
